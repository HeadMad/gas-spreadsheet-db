{
  "name": "gas-spreadsheet-db",
  "description": "is an ORM library for Google Apps Script that transforms Google Sheets into a high-performance, NoSQL-like database",
  "version": "1.0.0",
  "type": "module",
  "author": "HeadMad",
  "repository": "https://github.com/headmad/gas-spreadsheet-db",
  "bugs": {
    "url": "https://github.com/headmad/gas-spreadsheet-db/issues"
  },
  "homepage": "https://github.com/headmad/gas-spreadsheet-db#readme",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node build.js",
    "push": "npm run build && clasp push",
    "deploy": "npm run push && clasp deploy",
    "open": "clasp open"
  },
  "devDependencies": {
    "@google/clasp": "^3.1.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/google-apps-script": "^2.0.7",
    "esbuild": "^0.27.0",
    "svelte": "^5.43.12",
    "terser": "^5.44.1",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.0"
  }
}